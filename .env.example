# ==============================================================================
# SMART OPD ORCHESTRATION PLATFORM - BIẾN MÔI TRƯỜNG MẪU (.env)
# ==============================================================================

# 1. Cơ sở dữ liệu (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/hospital_db

# 2. Bảo mật & Xác thực JWT
SECRET_KEY=smart-opd-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 3. Kết nối AI Service
AI_SERVICE_URL=http://localhost:8001

# 4. Tham số nghiệp vụ bất biến (Theo docs/DOMAIN_RULES.md)
AI_INFERENCE_TIMEOUT_MS=500
ROUTE_COMPUTE_TIMEOUT_MS=3000
REALTIME_PROPAGATION_SECONDS=2
ROUTE_MIN_IMPROVEMENT_MINUTES=3
ROUTE_RECALC_COOLDOWN_SECONDS=30
WAIT_RETRY_SECONDS=60
STATUS_UNDO_WINDOW_SECONDS=60
OVERDUE_FACTOR=1.5
FACILITY_TIMEZONE=Asia/Ho_Chi_Minh
